# Public API entry point: Cloudflare ALIS Gateway
# /api/* routes to Spring Boot; /ai/* routes to FastAPI (prefix stripped).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8787

# Public browser Supabase client only. Configure strict Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional metadata worker used by legacy file metadata helpers.
NEXT_PUBLIC_FILE_WORKER_URL=https://filemeta-worker.lungaowen14.workers.dev
